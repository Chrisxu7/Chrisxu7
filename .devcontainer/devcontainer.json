{
  "name": "Oficina Virtual DEMO (Hermes3D)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "./scripts/oficina-demo.sh --preparar",
  "postStartCommand": "setsid nohup ./scripts/oficina-demo.sh > /tmp/oficina.log 2>&1 < /dev/null &",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Oficina Virtual", "onAutoForward": "openBrowser" },
    "18789": { "label": "Gateway demo (interno)", "onAutoForward": "ignore" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
